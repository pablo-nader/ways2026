# Copiar a legacy/.env para levantar el compose local (`cp env.example .env`).
# En EasyPanel estos mismos nombres se cargan como variables de entorno del servicio.

# Base
MYSQL_ROOT_PASSWORD=cambiar-esta-clave
DB_NAME=c1890978_alsina
DB_USER=ways
DB_PASSWORD=cambiar-esta-clave

# Aplicación
DB_HOST=mysql
DB_PORT=3306

# Sincronización de catálogo con otro local (pantalla "Actualizar").
# Con SYNC_REMOTE_HOST vacío, la pantalla queda deshabilitada.
SYNC_REMOTE_HOST=
SYNC_REMOTE_USER=
SYNC_REMOTE_PASSWORD=
SYNC_REMOTE_DB=ways
