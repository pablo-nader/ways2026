<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ways.Domain\Ways.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!-- ADR-16 (ServicioDeAprovisionamiento) necesita las extensiones "relational" de
         DatabaseFacade: CreateExecutionStrategy/BeginTransactionAsync/GetDbConnection. No
         acopla Application a un proveedor concreto (Npgsql sigue solo en Infrastructure) —
         "relational" es la categoría de motor (SQL con transacciones), no el motor puntual. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
